file(READ "${CMAKE_CURRENT_LIST_DIR}/kwin-versions.json" version_policy)
string(JSON branch_count LENGTH "${version_policy}" sourceBuildBranches)
math(EXPR last_branch "${branch_count} - 1")
set(source_build_branches)
foreach(index RANGE ${last_branch})
    string(JSON branch GET "${version_policy}" sourceBuildBranches ${index})
    list(APPEND source_build_branches "${branch}")
endforeach()
string(JSON exact_runtime GET "${version_policy}" requireExactRuntimeMatch)
if(NOT exact_runtime)
    message(FATAL_ERROR "Exact KWin build/runtime matching must remain enabled")
endif()

function(nds_kwin_source_supported version result)
    set(supported FALSE)
    if("${version}" MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
        set(branch "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
        if(branch IN_LIST source_build_branches)
            set(supported TRUE)
        endif()
    endif()
    set(${result} "${supported}" PARENT_SCOPE)
endfunction()
