# Installed as natural-desktop-slide-session.service.
[Unit]
Description=Natural Desktop Slide renderer and gesture handoff
After=plasma-kwin_wayland.service
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_TYPE=wayland
ConditionEnvironment=XDG_CURRENT_DESKTOP=KDE

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/python3 "@LIBEXECDIR@/startup-session.py" start
ExecStop=/usr/bin/python3 "@LIBEXECDIR@/startup-session.py" stop
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=graphical-session.target
